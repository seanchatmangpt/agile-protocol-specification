@prefix aps: <https://w3id.org/chatman/aps#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/chatman/aps> a owl:Ontology ;
  dcterms:title "Agile Protocol Specification v26.8.24 core profile" ;
  dcterms:description "A public-ontology-first profile for knowledge-work reconstitution, manufacture, authority, evidence, and standing." .

aps:AdmittedKnowledge a owl:Class ; rdfs:subClassOf prov:Entity ; skos:definition "Bounded knowledge admitted as manufacturing authority at a declared coordinate." .
aps:Contract a owl:Class ; rdfs:subClassOf prov:Entity ; skos:definition "Executable precondition, postcondition, invariant, refusal, authority, and evidence law." .
aps:ManufacturingStrategy a owl:Class ; rdfs:subClassOf prov:Plan ; skos:definition "Candidate method for manufacturing consequences from admitted knowledge." .
aps:CandidateFalsifier a owl:Class ; rdfs:subClassOf prov:Entity ; skos:definition "Explicit adversarial condition capable of refuting a bounded claim." .
aps:ActuationIntent a owl:Class ; rdfs:subClassOf prov:Plan ; skos:definition "Authorized proposal for consequential DO; existence alone confers no authority." .
aps:EvidenceReceipt a owl:Class ; rdfs:subClassOf prov:Entity ; skos:definition "Integrity-bound observation of requested and observed consequence at a coordinate." .
aps:StandingAssertion a owl:Class ; rdfs:subClassOf dqv:QualityMeasurement ; skos:definition "Bounded evidentiary standing assigned by a declared verifier." .
aps:Reconstitution a owl:Class ; rdfs:subClassOf prov:Activity ; skos:definition "Observation, admission, construction, qualification, selection, and sunset transition from predecessor evidence to successor standing." .

aps:derivedFromKnowledge a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasDerivedFrom .
aps:governedByContract a owl:ObjectProperty ; rdfs:range aps:Contract .
aps:hasCandidateFalsifier a owl:ObjectProperty ; rdfs:range aps:CandidateFalsifier .
aps:producedReceipt a owl:ObjectProperty ; rdfs:subPropertyOf prov:generated ; rdfs:range aps:EvidenceReceipt .
aps:requiresPolicy a owl:ObjectProperty ; rdfs:range odrl:Policy .
aps:validatedByShape a owl:ObjectProperty ; rdfs:range sh:Shape .

aps:ALIVE a skos:Concept ; skos:prefLabel "ALIVE" .
aps:PARTIAL_ALIVE a skos:Concept ; skos:prefLabel "PARTIAL_ALIVE" .
aps:BLOCKED a skos:Concept ; skos:prefLabel "BLOCKED" .
aps:BUILD_BROKEN a skos:Concept ; skos:prefLabel "BUILD_BROKEN" .
aps:UNKNOWN a skos:Concept ; skos:prefLabel "UNKNOWN" .
aps:UNSUPPORTED a skos:Concept ; skos:prefLabel "UNSUPPORTED" .
aps:REFUSED a skos:Concept ; skos:prefLabel "REFUSED" .

# v26.9.17 additions — swarm manufacturing, session history, operator glyphs

aps:SwarmPacingLaw a owl:Class ; rdfs:subClassOf aps:Contract ;
  skos:definition "Measured concurrency law: capacity is a function of model tier and agent weight; saturation by top-up, never burst; on rate refusal drain then halve pace." .
aps:SessionHistoryLaw a owl:Class ; rdfs:subClassOf aps:Contract ;
  skos:definition "Session state lives in versioned files with append-only history; planning reads tickets, not conversational memory." .
aps:OperatorGlyph a owl:Class ; rdfs:subClassOf skos:Concept ;
  skos:definition "Single defined glyph compressing one manufacturing stage; binding only via its declared mapping plus a repo-side enforcement anchor." .

aps:stageIndex a owl:DatatypeProperty ; rdfs:range xsd:integer ;
  skos:definition "Position of an operator glyph in the canonical manufacturing chain." .

aps:守 a aps:OperatorGlyph ; aps:stageIndex 1 ; skos:prefLabel "守"@ja ; skos:altLabel "preserve"@en ;
  skos:definition "Predecessor state and lawful options are preserved; admissible structure is never destroyed." .
aps:柵 a aps:OperatorGlyph ; aps:stageIndex 2 ; skos:prefLabel "柵"@ja ; skos:altLabel "fence"@en ;
  skos:definition "Boundary that fails closed; unknown reversibility is a fence." .
aps:算 a aps:OperatorGlyph ; aps:stageIndex 3 ; skos:prefLabel "算"@ja ; skos:altLabel "calculate"@en ;
  skos:definition "Lawful manufacture over admitted knowledge under admitted manufacturing law." .
aps:除 a aps:OperatorGlyph ; aps:stageIndex 4 ; skos:prefLabel "除"@ja ; skos:altLabel "exclude"@en ;
  skos:definition "Dropped alternatives are recorded; silent pruning is forbidden." .
aps:偽 a aps:OperatorGlyph ; aps:stageIndex 5 ; skos:prefLabel "偽"@ja ; skos:altLabel "falsify"@en ;
  skos:definition "Adversarial input is manufactured before the claim it tests." .
aps:延 a aps:OperatorGlyph ; aps:stageIndex 6 ; skos:prefLabel "延"@ja ; skos:altLabel "extend"@en ;
  skos:definition "An existing family is extended before a new pack is admitted." .
aps:実 a aps:OperatorGlyph ; aps:stageIndex 7 ; skos:prefLabel "実"@ja ; skos:altLabel "operationalize"@en ;
  skos:definition "Recurring exceptional judgment is promoted into ontology, policy, generator, verifier, or process control." .
