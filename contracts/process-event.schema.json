{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/chatman/aps/v26.8.24/process-event.schema.json",
  "title": "APS Object-Centric Process Event",
  "description": "OCEL-inspired event envelope for comparable enterprise process evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "activity", "time", "objects", "authorityRef", "receiptRef"],
  "properties": {
    "eventId": {"type":"string"},
    "activity": {"type":"string"},
    "time": {"type":"string","format":"date-time"},
    "objects": {"type":"array","minItems":1,"items":{"type":"object","required":["objectId","objectType"],"properties":{"objectId":{"type":"string"},"objectType":{"type":"string"}}}},
    "attributes": {"type":"object"},
    "authorityRef": {"type":"string"},
    "receiptRef": {"type":"string"},
    "provenanceRefs": {"type":"array","items":{"type":"string"}}
  }
}
