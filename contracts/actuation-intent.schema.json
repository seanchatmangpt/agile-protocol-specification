{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/chatman/aps/v26.8.24/actuation-intent.schema.json",
  "title": "APS Consequential Actuation Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["intentId", "contractId", "authorityRef", "executorRef", "action", "idempotencyKey", "limits"],
  "properties": {
    "intentId": {"type":"string"},
    "contractId": {"type":"string"},
    "authorityRef": {"type":"string"},
    "executorRef": {"type":"string"},
    "action": {"type":"object"},
    "idempotencyKey": {"type":"string","minLength":1},
    "limits": {"type":"object"},
    "expectedEvidence": {"type":"array","items":{"type":"string"}}
  }
}
