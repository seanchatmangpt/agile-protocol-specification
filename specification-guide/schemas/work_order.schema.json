{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aps:schema:work-order:v26.7.30",
  "title": "APS Work Order v26.7.30",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "release",
    "source",
    "target",
    "scope",
    "authority",
    "acceptance",
    "falsifiers",
    "evidence",
    "gall",
    "exclusions",
    "nonclaims"
  ],
  "properties": {
    "schema": {
      "const": "aps.work-order.v26.7.30"
    },
    "id": {
      "type": "string",
      "minLength": 3
    },
    "release": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "base": {
          "type": "string",
          "minLength": 7
        },
        "admitted_observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "consequence",
        "state"
      ],
      "properties": {
        "consequence": {
          "type": "string",
          "minLength": 10
        },
        "state": {
          "enum": [
            "Draft",
            "Provisional",
            "InReview",
            "Accepted",
            "Final"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "included",
        "forbidden"
      ],
      "properties": {
        "included": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "selector",
        "implementer",
        "verifier",
        "promoter"
      ],
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "implementer": {
          "type": "string",
          "minLength": 1
        },
        "verifier": {
          "type": "string",
          "minLength": 1
        },
        "promoter": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "command",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "unit",
              "integration",
              "e2e",
              "chaos",
              "stress",
              "benchmark",
              "verifier-report"
            ]
          }
        }
      }
    },
    "falsifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "same_object",
          "observation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "same_object": {
            "const": true
          },
          "observation": {
            "type": "string",
            "minLength": 5
          },
          "expected_refusal": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "coordinate_fields",
        "standing_ceiling",
        "receipt_schema"
      ],
      "properties": {
        "coordinate_fields": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "standing_ceiling": {
          "enum": [
            "PARTIAL_ALIVE",
            "ALIVE",
            "BLOCKED",
            "BUILD_BROKEN",
            "UNKNOWN",
            "UNSUPPORTED"
          ]
        },
        "receipt_schema": {
          "type": "string"
        }
      }
    },
    "gall": {
      "type": "object",
      "required": [
        "checkpoints"
      ],
      "properties": {
        "checkpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "claim",
              "predecessors"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "claim": {
                "type": "string"
              },
              "predecessors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "rollback": {
      "type": "object"
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
